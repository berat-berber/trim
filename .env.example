# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trim

# Public URL the client bundle uses to reach the API (baked in at build time).
# TLS is handled by Cloudflare in front of the proxy, so this is https.
PUBLIC_API_URL=https://trim.beratberber.com
